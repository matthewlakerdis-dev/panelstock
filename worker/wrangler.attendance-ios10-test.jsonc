{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panelstock-attendance-ios10-test",
  "main": "src/attendance-ios10-test.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-attendance-ios10",
    "binding": "ATTENDANCE_TEST_ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "ATTENDANCE_TEST_ENV": "ios10",
    "SITE_ID": "attendance-ios10-test",
    "MIGRATION_READY": "false",
    "EMAIL_ENABLED": "false",
    "READ_ONLY": "false",
    "ALLOWED_ORIGINS": ""
  },
  "durable_objects": {
    "bindings": [{"name": "INVENTORY", "class_name": "AttendanceIos10TestStore"}]
  },
  "migrations": [{"tag": "attendance-ios10-test-v1", "new_sqlite_classes": ["AttendanceIos10TestStore"]}]
}
