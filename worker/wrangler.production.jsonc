{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "panelstock-reports",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "routes": [{"pattern":"cnc.panelstockhq.com","custom_domain":true}],
  "observability": {"enabled": true},
  "vars": {
    "SITE_ID": "panelstock",
    "ALLOWED_ORIGINS": "https://app.panelstockhq.com,https://web.panelstockhq.com",
    "MIGRATION_READY": "false",
    "READ_ONLY": "false",
    "EMAIL_ENABLED": "true"
  },
  "durable_objects": {"bindings": [{"name": "INVENTORY", "class_name": "InventoryStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["InventoryStore"]}],
  "kv_namespaces": [{"binding": "LEGACY_KV", "id": "736a2c6bb92c4525b9cce15951c1d516"}],
  "triggers": {"crons": ["*/15 * * * *"]}
}
// Production deploy trigger for damage reason 007 photo exemption.
