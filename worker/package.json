{
  "name": "panelstock-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:attendance": "node scripts/build-attendance-compatible.mjs",
    "build:site": "node scripts/site-orders.mjs",
    "build:css": "node scripts/styles.cjs",
    "check:css": "node scripts/styles.cjs --check",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build:attendance && wrangler deploy --dry-run",
    "pretest": "node ../scripts/build-gate-pivot-preview.mjs --check && node scripts/build-gate-progress-client.mjs --check && node scripts/toolbox-page.mjs --check && npm run check:css && npm run build:attendance && wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@cloudflare/workers-types": "5.20260830.1",
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "miniflare": "5.20260828.0-alpha",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "wrangler": "4.127.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@pdf-lib/upng": "1.0.1",
    "pdf-lib": "1.17.1",
    "web-push": "^3.6.7"
  }
}
